# Persistent-env signers. Source before running smoke tests: set -a && source devenv/.env && set +a
#
# EVM: ccv reads PRIVATE_KEY at chain init (DeployerKey) for balance checks and sends.
# Put raw hex here (without 0x prefix)
PRIVATE_KEY=

# Solana: per-send override. Base58 private key/keypair or solana-keygen JSON array.
SOLANA_PRIVATE_KEY=
